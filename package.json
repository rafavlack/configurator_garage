    "three": "0.186.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "6.0.1",
    "gh-pages": "^6.3.0",
    "typescript": "5.9.3",
    "vite": "8.1.0"
